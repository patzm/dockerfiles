# Bee Flow self-hosted configuration

# Public URL for links and redirects
PUBLIC_URL=https://bee.patz.app

# Required secrets (32+ chars). Keep commented until you set real values.
# SESSION_SECRET=
# MASTER_ENCRYPTION_KEY=

# Optional bootstrap admin password (change after first login)
# INIT_ADMIN_PASSWORD=

# Images
BEEFLOW_SERVER_TAG=latest
BEEFLOW_UI_TAG=latest

# Postgres connection settings
DB_NAME=beeflow_core
DB_USER=beeflow
# DB_PASSWORD=

# Logging / locale
LOG_LEVEL=info
TIMEZONE=Europe/Berlin

# Ollama endpoint for Bee Flow (do not use localhost from inside container)
# Option A: Ollama in docker network
# OLLAMA_BASE_URL=http://ollama:11434
# Option B: Ollama on host
# OLLAMA_BASE_URL=http://host.docker.internal:11434
